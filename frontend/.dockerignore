# Docker 빌드 시 제외할 파일/폴더

# 의존성 (Docker 내부에서 npm ci로 설치)
node_modules/

# 빌드 결과물 (Docker 내부에서 빌드)
dist/
build/

# 개발 환경 파일
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE/Editor
.vscode/
.idea/
*.swp
*.swo

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 테스트
coverage/

# 기타
.git/
.gitignore
README.md
*.md

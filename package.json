{
  "name": "backtesting-workspace",
  "private": true,
  "version": "1.0.0",
  "description": "Backtesting monorepo workspace",
  "scripts": {
    "prepare": "husky",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && ruff check .",
    "format:frontend": "cd frontend && npm run format",
    "format:backend": "cd backend && ruff format ."
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "eslint --fix --config frontend/eslint.config.js",
      "prettier --write --config frontend/.prettierrc"
    ],
    "backend/**/*.py": [
      "ruff check --fix",
      "ruff format"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.4.0",
    "typescript-eslint": "^8.46.4"
  }
}
